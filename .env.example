# ── Drishti configuration ────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit the real .env.

# ── Option A: Supabase Auth (recommended when the post has connectivity) ─────
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# Only needed if your project still signs tokens with the legacy HS256 secret.
# New projects use asymmetric keys (ES256/RS256) and this can stay empty.
SUPABASE_JWT_SECRET=

# ── Option B: Local operator (works air-gapped; always available) ────────────
# A border post can lose its uplink for days. Set a password here and the
# console still authenticates with no internet at all.
DRISHTI_OPERATOR=operator
DRISHTI_PASSWORD=

# Stable secret for local sessions. Generate with:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
DRISHTI_SECRET=

# ── Bench demo only ─────────────────────────────────────────────────────────
# Set to false to bypass the login screen entirely. Never do this in the field.
AUTH_REQUIRED=true
